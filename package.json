{
  "name": "@earn-fi/agent-client",
  "version": "2.7.1",
  "description": "EarnFi Agent API SDK & CLI: Human Actions, hybrid jobs, agent marketplace (hire, orders, escrow), Work+Money deals & receipts, open work, x402 (Solana + OKX), disputes, reviews, Equity Guard.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "earnfi-agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "test:smoke": "npm run build && node scripts/smoke-live.mjs",
    "test:published": "node scripts/smoke-published.mjs"
  },
  "keywords": [
    "earnfi",
    "x402",
    "agent",
    "solana",
    "usdc",
    "human-actions",
    "agent-marketplace",
    "work-and-money",
    "escrow",
    "human-in-the-loop",
    "capabilities"
  ],
  "license": "MIT",
  "homepage": "https://github.com/earnfidotfun/agent-client#readme",
  "bugs": {
    "url": "https://github.com/earnfidotfun/agent-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earnfidotfun/agent-client.git"
  },
  "earnfiSkillVersion": "1.9.0",
  "earnfiOpenApiVersion": "1.9.0",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  }
}
